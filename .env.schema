# This env file uses @env-spec — see https://varlock.dev/env-spec
#
# @defaultRequired=false
# @defaultSensitive=true
# @currentEnv=$VARLOCK_ENV
# @generateTsTypes(path=env.d.ts)
# @plugin(@varlock/pass-plugin)
# @initPass()
# ---

# GA4 web-stream measurement ID. This identifier is public by design.
# @sensitive=false @required @type=string(matches=regex("^G-[A-Z0-9]+$"))
# @docs(https://support.google.com/analytics/answer/9539598)
PUBLIC_GA_MEASUREMENT_ID=G-DTZYQSS4SE

# Cloudflare Turnstile site key. The production key is public; local dev and
# preview use Cloudflare's always-pass test key (see `.env.development`).
# @sensitive=false @required
PUBLIC_TURNSTILE_SITE_KEY=pass("mithqal-calculator/production/PUBLIC_TURNSTILE_SITE_KEY")

# Comma-separated hostnames allowed by Turnstile verification.
# @sensitive=false @required
TURNSTILE_HOSTNAMES=mithqal.app

# Turso database used by the storefront and the scheduled rates refresh.
# Resolves from pass everywhere, including local dev.
# @required @type=string(startsWith=turso://)
TURSO_DATABASE_URL=pass("mithqal-calculator/production/TURSO_DATABASE_URL")

# Turso authentication token for the remote database.
# @required
TURSO_AUTH_TOKEN=pass("mithqal-calculator/production/TURSO_AUTH_TOKEN")

# Address returned only after successful server-side Turnstile verification.
# @required @type=email
CONTACT_EMAIL=pass("mithqal-calculator/production/CONTACT_EMAIL")

# Turnstile secret key. Local dev and preview use Cloudflare's always-pass test
# key (see `.env.development`).
# @required
TURNSTILE_SECRET_KEY=pass("mithqal-calculator/production/TURNSTILE_SECRET_KEY")

# FXRatesAPI server API key used only by the scheduled Worker.
# @docs(https://fxratesapi.com/docs)
# @required @type=string(startsWith=fxr_)
FXRATESAPI_SERVER_KEY=pass("mithqal-calculator/production/FXRATESAPI_SERVER_KEY")

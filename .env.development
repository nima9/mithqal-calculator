# Local development overrides. Tracked in git — safe for agents to read/edit.
# No secrets here; everything sensitive resolves from `pass` via `.env.schema`.

# Cloudflare's always-pass Turnstile test keys for local dev + `wrangler preview`.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
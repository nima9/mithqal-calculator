# Use a development-only Turso database here. Production credentials belong in
# Cloudflare Worker secrets, never in this file.
TURSO_DATABASE_URL=turso://your-development-database.turso.io
TURSO_AUTH_TOKEN=your_development_token

# Address returned only after successful server-side Turnstile verification.
CONTACT_EMAIL=you@example.com

# Cloudflare's always-pass test keys for local development (vite dev + wrangler preview).
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Public GA4 web-stream measurement ID (Analytics > Admin > Data streams).
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

{
  "name": "mithqal-culator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "varlock-wrangler dev --port 4173",
    "deploy": "bun run validate && varlock-wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && varlock-wrangler types && svelte-check --tsconfig ./tsconfig.json && tsc --project ./tsconfig.worker.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint:check": "oxlint",
    "lint": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "i18n": "wuchale",
    "validate": "bun run check && bun run lint && bun run format:check && bun test && bun run build",
    "env:check": "varlock load --agent",
    "env:check-prod": "VARLOCK_ENV=production varlock load --agent",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:seed": "varlock run -- bun run scripts/seed.ts",
    "cf:types": "varlock-wrangler types"
  },
  "dependencies": {
    "@tursodatabase/serverless": "^1.4.0",
    "bits-ui": "^2.19.2",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "^3.22.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^26.6.2",
    "@varlock/cloudflare-integration": "^1.6.0",
    "@varlock/pass-plugin": "^1.0.2",
    "@varlock/vite-integration": "^1.5.2",
    "@wuchale/svelte": "^0.21.4",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "varlock": "^1.20.0",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3",
    "wuchale": "^0.26.7"
  }
}

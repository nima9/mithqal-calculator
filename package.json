{
  "name": "mithqal-culator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite dev",
    "build": "bun run --bun vite build && node scripts/append-cron-handler.mjs",
    "preview": "wrangler dev --port 4173",
    "deploy": "bun run build && wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write . && prettier --write \"**/*.svelte\"",
    "format:check": "oxfmt --check . && prettier --check \"**/*.svelte\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run scripts/seed.ts",
    "gen": "wrangler types"
  },
  "dependencies": {
    "@tursodatabase/serverless": "^1.4.0",
    "bits-ui": "^2.15.5",
    "drizzle-orm": "1.0.0-rc.4",
    "neverthrow": "^8.2.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.7",
    "@sveltejs/enhanced-img": "^0.10.2",
    "@sveltejs/kit": "^2.51.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25",
    "daisyui": "^5.5.18",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.50.3",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.65.0"
  }
}

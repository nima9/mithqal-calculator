{
  "name": "mithqal-calculator",
  "account_id": "f2bcc8def8608fd9f1009912570164ce",
  "compatibility_date": "2026-01-25",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "main": "worker/index.ts",
  // Env vars and secrets are managed by Varlock (`.env.schema`).
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "triggers": {
    "crons": ["0 6,18 * * *", "15 6 1 * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
